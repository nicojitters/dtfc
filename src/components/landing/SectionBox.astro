---
import type { Box, BoxMode } from '@/data/landing';
import BoxContent from './BoxContent.astro';

interface Props {
  box: Box;
  mode: BoxMode;
  class?: string;
}
const { box, mode, class: className = '' } = Astro.props;
---

<li class={`list-none ${className}`.trim()}>
  <a
    href={box.href}
    class="border-ink-500/15 bg-white hover:border-teal-600/60 focus-visible:ring-clay-500 block h-full rounded-[var(--radius-card)] border p-6 no-underline transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-soft)] focus-visible:ring-2 focus-visible:ring-offset-2"
  >
    <h2 class="font-display text-ink-900 text-xl">{box.label}</h2>
    <BoxContent box={box} mode={mode} />
  </a>
  <slot />
</li>
