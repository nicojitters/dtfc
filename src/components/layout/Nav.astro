---
import { NAV_ITEMS, type NavKey } from '@/lib/nav';
interface Props {
  section?: NavKey;
  class?: string;
}
const { section, class: className = '' } = Astro.props;
---

<ul class={`flex flex-col gap-1 lg:flex-row lg:items-baseline lg:gap-5 ${className}`}>
  {
    NAV_ITEMS.map((item) => (
      <li>
        <a
          href={item.href}
          class={`hover:text-clay-500 inline-flex flex-col items-start whitespace-nowrap py-1 leading-tight no-underline ${
            item.comingSoon ? 'text-ink-500' : 'text-ink-900'
          } ${section === item.key ? 'border-clay-500 border-b-2' : ''}`}
          aria-current={section === item.key ? 'page' : undefined}
        >
          <span>{item.label}</span>
          {item.comingSoon && (
            <span class="text-mustard-800 mt-0.5 text-[0.625rem] font-semibold tracking-widest uppercase">
              Coming Next Year
            </span>
          )}
        </a>
      </li>
    ))
  }
</ul>
