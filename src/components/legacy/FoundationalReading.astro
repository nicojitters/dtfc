---
import { FOUNDATIONAL_READING } from '@/data/foundational-reading';
---

<ul class="mt-4 list-none space-y-3 pl-0">
  {
    FOUNDATIONAL_READING.map((work) => (
      <li class="border-ivory-200 border-l-4 pl-4">
        <p class="text-ink-900">
          <span class="font-medium">{work.author}</span>
          {work.title && (
            <>
              {' '}
              &mdash; <em>{work.title}</em>
            </>
          )}
          {work.year && <> ({work.year})</>}
          {!work.title && !work.year && <span class="text-ink-500">.</span>}
        </p>
        {work.note && <p class="text-ink-500 mt-1 text-sm italic">{work.note}</p>}
      </li>
    ))
  }
</ul>
