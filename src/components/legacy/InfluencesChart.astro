---
import { INFLUENCES_CHART } from '@/data/influences-chart';

interface Props {
  id?: string;
  caption?: string;
}
const {
  id,
  caption = 'Theatre traditions that shaped Developmental Theatre',
} = Astro.props;
---

<figure class="my-8" id={id}>
  <div class="overflow-x-auto">
    <table class="border-ink-500/15 w-full min-w-[720px] border-collapse border text-sm">
      <caption class="text-ink-500 caption-top pb-3 text-left text-sm">
        {caption}
      </caption>
      <thead>
        <tr class="bg-white/40">
          <th
            scope="col"
            class="bg-white border-ink-500/15 sticky left-0 z-10 border p-2 text-left align-bottom"
          >
            Theatre Convention
          </th>
          {
            INFLUENCES_CHART.columns.map((col) => (
              <th scope="col" class="border-ink-500/15 border p-2 text-left align-bottom">
                <div class="font-medium">{col.label}</div>
                {col.subtitle && (
                  <div class="text-ink-500 text-xs font-normal">({col.subtitle})</div>
                )}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          INFLUENCES_CHART.rows.map((row) => (
            <tr>
              <th
                scope="row"
                class="bg-white border-ink-500/15 text-ink-900 sticky left-0 border p-2 text-left align-top font-medium"
              >
                {row.label}
              </th>
              {row.values.map((cell) => (
                <td class="border-ink-500/15 text-ink-700 border p-2 align-top">{cell}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>
