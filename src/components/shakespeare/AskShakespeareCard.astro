---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'askShakespeare'>;
}
const { entry } = Astro.props;
const slug = entry.id.replace(/\.mdx?$/, '');
const href = `/shakespeare/ask-shakespeare/${slug}/`;
---

<article class="border-ivory-200 bg-ivory-50 hover:border-teal-600/60 rounded-[var(--radius-card)] border p-5 transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-soft)]">
  {entry.data.draft && (
    <span class="inline-block text-xs px-2 py-0.5 rounded bg-amber-100 text-amber-900 mb-2">
      Draft &mdash; not yet published
    </span>
  )}
  {/* CLIENT REVIEW: image rights pending client confirmation — Track P bundle #5 */}
  <img
    src="/images/ask-shakespeare/shakespeare-column-graphic.jpg"
    alt="Ask Shakespeare column graphic"
    class="w-16 h-16 rounded object-cover mb-2"
    loading="lazy"
  />
  <div class="flex items-baseline gap-3">
    <span class="text-mustard-800 text-xs font-semibold tracking-widest uppercase">
      #{entry.data.columnNumber}
    </span>
    <span class="text-ink-500 text-xs">{entry.data.publishedIn}</span>
    {entry.data.sample && <span class="text-ink-500 text-xs italic">· sample</span>}
  </div>
  <h3 class="font-display text-ink-900 mt-2 text-xl">
    <a href={href} class="hover:text-teal-600 no-underline">
      {entry.data.title}
    </a>
  </h3>
  <p class="text-ink-700 mt-2 text-sm">{entry.data.excerpt}</p>
</article>
